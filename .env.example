SMART_LEARNING_HOST=127.0.0.1
SMART_LEARNING_PORT=8765

# 软件运行数据目录
SMART_LEARNING_DATA_DIR=data

# 留空，使用默认 SQLite 数据库
SMART_LEARNING_DATABASE_URL=

# 数据库备份目录
SMART_LEARNING_BACKUP_DIR=data/backups

# 项目内部资源配置目录
SMART_LEARNING_RESOURCES_DIR=resources

# 赛题原始课程标准及教材 PDF 所在目录
SMART_LEARNING_SOURCE_FILES_DIR=
# 前端构建产物目录
SMART_LEARNING_WEB_DIST_DIR=apps/web/dist
# 可选：OpenAI 兼容的 chat completions 服务商。把本文件复制为 .env 后再填写。
# 请填写服务商完整的 HTTPS /chat/completions 地址。切勿提交真实密钥。
MODEL_PROVIDER=deepseek
MODEL_API_URL=https://api.deepseek.com/chat/completions
MODEL_API_KEY=
MODEL_NAME=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
# PDF/教材自动解析使用 DeepSeek OCR；同样读取 MODEL_API_KEY（provider=deepseek）或 DEEPSEEK_API_KEY。
DEEPSEEK_OCR_API_URL=https://api.deepseek.com/v1/tools/ocr
DEEPSEEK_OCR_TIMEOUT_SECONDS=180
DEEPSEEK_API_KEY=