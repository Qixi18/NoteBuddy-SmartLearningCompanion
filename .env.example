SMART_LEARNING_HOST=127.0.0.1
SMART_LEARNING_PORT=8765
# Relative paths are resolved from the repository root, regardless of CWD.
SMART_LEARNING_DATA_DIR=data
SMART_LEARNING_DATABASE_URL=
SMART_LEARNING_BACKUP_DIR=
SMART_LEARNING_RESOURCES_DIR=resources
# Optional: directory containing the allowlisted curriculum/textbook PDF files.
# Browser uploads use this when their temporary upload folder has no source package.
SMART_LEARNING_SOURCE_FILES_DIR=
# Optional; defaults to apps/backend/app/web/dist.
SMART_LEARNING_WEB_DIST_DIR=apps/backend/app/web/dist
# Optional OpenAI-compatible chat completions provider. Copy this file to .env.
# Use the provider's full HTTPS /chat/completions URL. Never commit a real key.
MODEL_PROVIDER=deepseek
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
# PDF/教材自动解析使用 DeepSeek OCR；同样读取 MODEL_API_KEY（provider=deepseek）或 DEEPSEEK_API_KEY。
DEEPSEEK_OCR_API_URL=https://api.deepseek.com/v1/tools/ocr
DEEPSEEK_OCR_TIMEOUT_SECONDS=180
